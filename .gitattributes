# GitHub normalizes CRLF to LF on commit unless told otherwise, which breaks
# the file hashes packwiz refresh computes locally. Force LF for served files.
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.html text eol=lf
/mods/.gitkeep text eol=lf
config/** text=auto eol=lf

# Byte-exact copy derived from the live server's CRLF config; its hash is pinned by the restart launcher.
scripts/hosted/trials-botania-overrides.json -text