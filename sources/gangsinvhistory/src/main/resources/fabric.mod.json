{
  "schemaVersion": 1,
  "id": "gangsinvhistory",
  "version": "${version}",
  "name": "Gangs Inventory History",
  "description": "Archives player inventories, ender chests and referenced backpack contents on join, leave, death and dimension change for a configurable number of days.",
  "authors": ["The Gangs"],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": ["com.gangs.invhistory.InvHistoryMod"]
  },
  "mixins": ["gangsinvhistory.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.6",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "fabric-permissions-api-v0": "*"
  }
}
